# Default is a clearly labelled local demo; live mode never falls back on failure.
EXPO_PUBLIC_BACKEND_MODE=demo
# Live auth uses email + password; signup also confirms the password locally.
# Enable Email signup, automatic confirmation and minimum password length 8.
# Signup/login need no SMTP or email OTP. Google/Apple are optional providers.
# See supabase/README.md and docs/build.md for live Auth and EAS environments.
# EXPO_PUBLIC_BACKEND_MODE=supabase
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Never use the service_role key in the app.
# Android native map builds: Maps SDK for Android key restricted to this app's
# package name and signing certificate. iOS uses Apple Maps; web uses OSM.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your-restricted-android-maps-key
# AI secrets belong in Supabase Edge Function secrets, never EXPO_PUBLIC_*.

# Match the providers enabled in Supabase Auth. Apple stays hidden until configured.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=true
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
