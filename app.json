{
  "expo": {
    "name": "Darsino",
    "slug": "darsino",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.darsino.app"
    },
    "android": {
      "package": "uz.darsino.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "lang": "uz",
      "themeColor": "#092B53",
      "description": "Maqsadingizga mos repetitorni toping, guruhga ariza yuboring va darslaringizni kuzating."
    },
    "plugins": ["expo-font", "expo-secure-store", "expo-notifications"]
  }
}
