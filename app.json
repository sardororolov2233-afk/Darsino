{
  "expo": {
    "name": "O‘qi",
    "slug": "oqi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.darsino.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "uz.darsino.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "lang": "uz",
      "themeColor": "#B5E6B8",
      "description": "O‘qi — mos ustoz topish, darslar, uy vazifalari va ta’lim natijalari."
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqiningizdagi ustozlarni topish va dars manzilini belgilash uchun joylashuvga ruxsat bering.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-document-picker",
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profilingizga rasm qo‘yish uchun O‘qi ilovasiga rasmlaringizdan tanlashga ruxsat bering.",
          "cameraPermission": "O‘qi ID kartasidagi QR kodni o‘qish uchun kameraga ruxsat bering.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O‘qi ID kartasidagi QR kodni o‘qish uchun kameraga ruxsat bering.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "darsino"
  }
}
