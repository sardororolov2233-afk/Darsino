{
  "expo": {
    "name": "O‘qi",
    "slug": "oqi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.darsino.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "uz.darsino.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "lang": "uz",
      "themeColor": "#0F265C",
      "description": "O‘qi — ustozlar, ochiq darslar va bilim radari. O‘zingizga mos ta’lim yo‘lini toping."
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profilingizga rasm qo‘yish uchun O‘qi ilovasiga rasmlaringizdan tanlashga ruxsat bering.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "darsino"
  }
}
