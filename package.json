  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/auth.test.ts tests/domain.test.ts tests/database.test.ts tests/storage.test.ts tests/supabaseClient.test.ts tests/persistence.test.ts tests/learning.test.ts tests/teacher.test.ts tests/teacherDatabase.test.ts tests/assistant.test.ts tests/backendFeatures.test.ts tests/onboarding.test.ts tests/payments.test.ts tests/account.test.ts tests/accountDatabase.test.ts tests/i18n.test.ts tests/backendAccess.test.ts tests/backendScheduling.test.ts tests/assistantRecovery.test.ts tests/storageLimits.test.ts tests/backendCoordination.test.ts tests/apiReliability.test.ts tests/storageLifecycle.test.ts tests/supabasePreflight.test.ts tests/demoPasswordAuth.test.ts tests/nativeCrypto.test.ts tests/classroom.test.ts tests/classroomDatabase.test.ts tests/tutorApplication.test.ts tests/workspacePolish.test.ts",
    "export:web": "expo export --clear --platform web",
    "test:e2e": "playwright test",
    "export:all": "expo export --clear --platform all --max-workers 1",
    "test:ui": "EXPO_PUBLIC_BACKEND_MODE=demo expo export --clear --platform web --max-workers 1 && node --import tsx --test tests/ui.test.ts",
    "format:check": "prettier --check App.tsx src tests scripts README.md docs/*.md supabase/README.md package.json app.json tsconfig.json playwright.config.ts app.config.ts supabase/functions",
    "supabase:bundle": "node scripts/build-supabase.mjs",
    "supabase:check": "node scripts/build-supabase.mjs --check",
    "typecheck:edge": "deno check --config supabase/functions/oqi-assistant/deno.json --node-modules-dir=manual --no-lock supabase/functions/oqi-assistant/index.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "postinstall": "node scripts/prepare-qr-scanner.mjs",
    "prestart": "node scripts/prepare-qr-scanner.mjs",
    "preexport:all": "node scripts/prepare-qr-scanner.mjs",
    "preexport:web": "node scripts/prepare-qr-scanner.mjs",
    "pretest:ui": "node scripts/prepare-qr-scanner.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
